      "id": "motors",
      "title": "モーター出力",
      "kind": "robot",
      "summary": "GPIOをLOWにして停止を維持する。",
      "body": "initializeMotors()は出力値をLOWにしてから出力モードへ設定する。loop()でもstopMotors()を呼ぶ。DRV8835のIN/INモードでLOW/LOWは空転停止。現在は前進・旋回コードを持たない。",
      "inputs": [
        "initializeMotors() / stopMotors()"
      ],
      "outputs": [
        "GPIO25 / 26 / 27 / 14 = LOW"
      ],
      "sources": [
        {
          "path": "firmware/src/motor_control.cpp",
          "find": "void initializeMotors()"
        },
        {
          "path": "firmware/src/motor_control.cpp",
          "find": "void stopMotors()"
        },
        {
          "path": "firmware/src/main.cpp",
          "find": "void setup()"
        }
      ],
      "facts": [
        [
          "起動時",
          "通信処理より先に停止出力を初期化"
        ],
        [
          "停止の意味",
          "位置やモーター電流を計測した結果ではない"
        ],
        [
          "Phase 2前提",
          "HTTPを独立させ、停止監視を妨げない構造へ変更"
        ]
      ],
      "flow": [
        {
          "label": "起動直後",
          "code": "initializeMotors()"
        },
        {
          "label": "出力モードを設定",
          "code": "GPIO 25 / 26 / 27 / 14"
        },
        {
          "label": "毎ループ停止を維持",
          "code": "stopMotors() → LOW"
        }
      ]
    },
